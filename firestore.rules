rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /businesses/{id} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name','gstin','address','state','phone','defaultTaxRate']);
    }
    match /customers/{id} {
      allow read: if true;
      allow create: if request.resource.data.billCount == 0 && request.resource.data.totalSpent == 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name','phone','gstin','state','notes']);
      allow delete: if true;
    }
    match /services/{id} {
      allow read, write: if true;
    }
    match /bills/{id} {
      allow read: if true;
      allow write: if false;   // server (admin SDK) only
    }
    match /billItems/{id}  { allow read: if true; allow write: if false; }
    match /payments/{id}   { allow read: if true; allow write: if false; }
    match /summaries/{id}  { allow read: if true; allow write: if false; }
    match /publicShares/{id} { allow read, write: if false; }
  }
}