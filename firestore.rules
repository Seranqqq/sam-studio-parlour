rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.role == 'owner'; }
    function inBiz(b) {
      return signedIn() && (request.auth.token.role == 'owner'
        || (request.auth.token.businessIds != null && b in request.auth.token.businessIds));
    }

    match /businesses/{id} {
      allow read: if inBiz(id);
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name','gstin','address','state','phone','defaultTaxRate']);
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
    }
    match /customers/{id} {
      allow read: if inBiz(resource.data.businessId);
      allow create: if inBiz(request.resource.data.businessId)
        && request.resource.data.billCount == 0 && request.resource.data.totalSpent == 0;
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name','phone','gstin','state','notes']);
      allow delete: if isOwner();
    }
    match /services/{id} {
      allow read: if inBiz(resource.data.businessId);
      allow write: if isOwner();
    }
    match /bills/{id} {
      allow read: if inBiz(resource.data.businessId)
        && (isOwner() || resource.data.createdBy == request.auth.uid);
      allow write: if false;   // server (admin SDK) only
    }
    match /billItems/{id}  { allow read: if isOwner(); allow write: if false; }
    match /payments/{id}   { allow read: if isOwner(); allow write: if false; }
    match /summaries/{id}  { allow read: if isOwner(); allow write: if false; }
    match /publicShares/{id} { allow read, write: if false; }
  }
}